# Copy to .env. Replace all password placeholders before starting.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Runtime uses the non-owner app role. Never use the owner/admin URL for the API.
DATABASE_URL=postgresql://hireai_app:replace_app_password@localhost:5432/hireai
# Used only by migration/bootstrap commands. Do not supply this to the API service.
DATABASE_MIGRATION_URL=postgresql://hireai_owner:replace_owner_password@localhost:5432/hireai
# Compose initializes separate roles on the first start of an empty data volume.
# Use URI-safe passwords (for example randomBytes(...).toString('base64url')).
# Keep each password consistent with its URL above when running Node on the host.
POSTGRES_ADMIN_PASSWORD=replace_postgres_admin_password
HIREAI_OWNER_PASSWORD=replace_owner_password
HIREAI_APP_PASSWORD=replace_app_password
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
CORS_ORIGINS=http://localhost:5173
# Defaults to true outside production and false in production when omitted.
# SWAGGER_ENABLED=false
# Set the actual number of trusted proxy hops; direct connections use false.
TRUST_PROXY=false
# Only for a separate disposable test database and administrative fixtures.
# TEST_ADMIN_DATABASE_URL=postgresql://postgres:replace_postgres_admin_password@localhost:5432/hireai_test

# Planning records only. No telephony provider or dialing worker is included.
CALL_PLANNING_ENABLED=false
CALL_TIMEZONE=Asia/Kolkata
CALL_WINDOW_START=09:00
CALL_WINDOW_END=18:00

# Bootstrap the SaaS platform owner with npm run bootstrap:platform.
# Use a dedicated platform tenant; do not reuse an organization containing business data.
# Set a unique admin password of at least 12 characters before bootstrap.
BOOTSTRAP_TENANT_NAME=Suretek Platform
BOOTSTRAP_TENANT_SLUG=platform
BOOTSTRAP_ADMIN_NAME=Suretek Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# Recommended for bootstrap: choose a stable tenant UUID, or an existing tenant's ID.
# Generate once with: node -e "console.log(require('node:crypto').randomUUID())"
# Without an ID, bootstrap creates a new tenant and prints its generated UUID.
# Save and reuse that ID for every retry of this tenant's bootstrap.
BOOTSTRAP_TENANT_ID=

# Optional TLS for a hosted database. Certificate verification remains enabled.
# PGSSLMODE=require

# Defaults to true in production, false in development/test.
# OFFER_MAKER_CHECKER=true

# Public careers, independent fixed-window limits, and evidence notice version.
# New tenants default to tenant-<UUID>; bootstrap can assign a public slug.
# BOOTSTRAP_TENANT_SLUG=suretek
INTAKE_NOTICE_VERSION=2026-11-v1
INTAKE_IP_LIMIT=20
INTAKE_EMAIL_LIMIT=5
INTAKE_WINDOW_SECONDS=3600
CANDIDATE_RETENTION_DAYS=365

# Local private storage is development/test only. Never serve this directory.
RESUME_STORAGE=local
RESUME_STORAGE_ROOT=var/private/resumes
RESUME_MAX_BYTES=5242880
# In production select s3 and supply all four required values through secrets.
# RESUME_STORAGE=s3
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=private-resumes
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=

# Explicit production readiness decisions. pending keeps documents quarantined.
MALWARE_SCANNER=pending
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
DOCUMENT_SCAN_MAX_ATTEMPTS=3
CAPTCHA_PROVIDER=disabled
CAPTCHA_DISABLED_ACKNOWLEDGED=false
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=careers.example.com
# TURNSTILE_EXPECTED_ACTION=apply
TURNSTILE_TIMEOUT_MS=5000
RESUME_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=false
CONTACT_VERIFICATION_TTL_SECONDS=1800
# Real MinIO integration tests require the readiness services and private bucket.
# MINIO_TEST_ENDPOINT=http://127.0.0.1:9000

# Email: log (development), disabled, or authenticated mandatory-TLS SMTP.
EMAIL_ADAPTER=log
EMAIL_DISABLED_ACKNOWLEDGED=false
# PUBLIC_WEB_BASE_URL=https://your-web-origin
# SMTP_HOST=smtp.your-provider.test
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=verify@your-domain.test
SMTP_TIMEOUT_MS=10000
# Invitation links expire after 24 hours by default (60–604800 seconds).
INVITATION_TTL_SECONDS=604800
# Local login diagnostic: select the same organization key as the sign-in form.
# AUTH_CHECK_ORGANIZATION=platform
# AUTH_CHECK_EMAIL=
# AUTH_CHECK_PASSWORD=
# Use deploy/generate-secrets.sh and deploy/README.md for production settings.
# Super Admin bootstrap (no default password). Retain BOOTSTRAP_TENANT_ID on reruns.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_INITIAL_PASSWORD=
# 32 random bytes encoded as 64 hex characters; keep stable and back it up securely.
INTEGRATION_ENCRYPTION_KEY=
# Optional operator-controlled HTTPS health endpoints for bearer-token providers.
# Never put credentials in these URLs. Redirects are refused.
INTEGRATION_TELEPHONY_VERIFY_URL=
INTEGRATION_EMAIL_VERIFY_URL=
INTEGRATION_CAREERS_CMS_VERIFY_URL=
INTEGRATION_E_SIGNATURE_VERIFY_URL=
INTEGRATION_HRIS_VERIFY_URL=

# Organization-owned integrations: operator-trusted endpoints, never client URLs.
# SMTP uses verified TLS on 465 (implicit) or 587 (STARTTLS).
INTEGRATION_EMAIL_SMTP_HOST=
INTEGRATION_EMAIL_SMTP_PORT=
INTEGRATION_TELEPHONY_TOKEN_URL=
INTEGRATION_CAREERS_CMS_TOKEN_URL=
INTEGRATION_E_SIGNATURE_TOKEN_URL=
INTEGRATION_HRIS_TOKEN_URL=
INTEGRATION_TELEPHONY_API_KEY_HEADER=
INTEGRATION_EMAIL_API_KEY_HEADER=
INTEGRATION_CAREERS_CMS_API_KEY_HEADER=
INTEGRATION_E_SIGNATURE_API_KEY_HEADER=
INTEGRATION_HRIS_API_KEY_HEADER=
