{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	admin 127.0.0.1:2019
	log {
		format filter {
			wrap json
			fields {
				request delete
				msg delete
				error delete
				email delete
				contact delete
				resp_headers delete
			}
		}
	}
}
{$DOMAIN} {
	# Resume uploads (public applications and staff uploads) may carry up to
	# RESUME_MAX_BYTES (5 MB by default) plus form overhead; everything else 1 MB.
	# Raise both together if RESUME_MAX_BYTES grows.
	@uploads path_regexp ^/api/v1/(public/[a-z0-9-]+/jobs/[0-9a-f-]+/applications|candidates/[0-9a-f-]+/documents)$
	request_body @uploads {
		max_size 6MB
	}
	@small not path_regexp ^/api/v1/(public/[a-z0-9-]+/jobs/[0-9a-f-]+/applications|candidates/[0-9a-f-]+/documents)$
	request_body @small {
		max_size 1MB
	}
	header {
		?X-Request-ID {http.request.uuid}
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
	# Verification emails sent before the console page existed linked here.
	# Browsers keep the #token fragment across the redirect.
	redir /contact-verification /console/contact-verification 308
	@docs path /docs* /api/v1/docs*
	respond @docs 404
	@console path /console /console/*
	handle @console {
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Public careers pages may show the Cloudflare Turnstile check.
		@careers path /console/careers /console/careers/*
		header @careers Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		@assets path /console/assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@page not path /console/assets/*
		header @page Cache-Control "no-store"
		try_files {path} /console/index.html
		file_server
	}
	handle {
		reverse_proxy api:3000
	}
	# Access logs intentionally disabled. API emits IDs/status/duration only,
	# never URLs, queries, addresses, headers or bodies.
}

# Explicit external-443 redirect: internal high ports must not appear in Location.
http://{$DOMAIN}:8080 {
	header ?X-Request-ID {http.request.uuid}
	redir https://{$DOMAIN}{uri} permanent
}
