{
  "name": "suretek-hireai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Suretek HireAI + HRMS Node.js/PostgreSQL backend starter",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "retention": "node dist/scripts/retention.js",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "lint": "eslint src scripts test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "enums:generate": "tsx scripts/generate-enum-migration.ts",
    "enums:check": "tsx scripts/generate-enum-migration.ts --check",
    "documents:scan": "node dist/scripts/documents-scan.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "dotenv": "^18.0.10",
    "helmet": "^8.1.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.12",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "smtp-server": "^3.21.6",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
